DirectoryIndex index.php

# HTTP to HTTPS redirect
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Route public storefront HTML through the Japan access gate.
RewriteRule ^index\.html$ / [R=302,L,NE]
RewriteRule ^faq\.html$ /faq.php [R=302,L,NE]
RewriteRule ^data/ - [F,L]

# Pretty product URLs: /product/{id} -> /product.php?id={id}
RewriteRule ^product/([^/]+)/?$ /product.php?id=$1 [L]

# Dynamic sitemap: /sitemap.xml -> /sitemap.php
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Disable cache for Bing site verification
<Files BingSiteAuth.xml>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</Files>
